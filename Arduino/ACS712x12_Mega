// ===============================
// ACS712 x 12 on Arduino MEGA2560
// ===============================

const int SENSOR_COUNT = 12;

const int ACS_PINS[SENSOR_COUNT] = {
  
  A2, A10, A3, A11,   // LD
  A4, A12, A5, A13,   // CH
  A0, A8, A1, A9      // ULD
};

float sensitivity[SENSOR_COUNT] = {
  0.100, 0.100, 0.100, 0.100, 0.100, 0.100,
  0.100, 0.100, 0.100, 0.100, 0.100, 0.100
};

float zeroOffsetV[SENSOR_COUNT] = {
  2.5, 2.5, 2.5, 2.5, 2.5, 2.5,
  2.5, 2.5, 2.5, 2.5, 2.5, 2.5
};

const int CAL_SAMPLES = 500;

const float ADC_REF = 5.0;
const float ADC_RESOLUTION = 1023.0;

const unsigned long SAMPLE_INTERVAL_MS = 100;
unsigned long lastSampleTime = 0;

float voltageSum[SENSOR_COUNT] = {0};
float currentSum[SENSOR_COUNT] = {0};

unsigned long sampleCount = 0;

float readVoltageOnce(int pin) {

  const int SAMPLE_COUNT = 20;
  long sum = 0;

  analogRead(pin); 
  delayMicroseconds(100);

  for (int i = 0; i < SAMPLE_COUNT; i++) {
    sum += analogRead(pin);
    delayMicroseconds(100);
  }

  float avgAdc = (float)sum / SAMPLE_COUNT;

  return avgAdc * (ADC_REF / ADC_RESOLUTION);
}

float calibrateZeroOffset(int pin) {
  long sum = 0;

  for (int i = 0; i < CAL_SAMPLES; i++) {
    sum += analogRead(pin);
    delay(2);
  }

  float adc = (float)sum / CAL_SAMPLES;
  return adc * (ADC_REF / ADC_RESOLUTION);
}

void accumulateSensorData() {
  for (int i = 0; i < SENSOR_COUNT; i++) {
    float vout = readVoltageOnce(ACS_PINS[i]);

    float amps = (vout - zeroOffsetV[i]) / sensitivity[i];

    voltageSum[i] += vout;
    currentSum[i] += amps;
  }

  sampleCount++;
}

void sendAverageDataAndReset() {
  if (sampleCount == 0) {
    Serial.println("NO_DATA");
    return;
  }

  for (int i = 0; i < SENSOR_COUNT; i++) {

    // 평균 전류 계산
    float avgAmps = currentSum[i] / sampleCount;

    // 음수 전류를 양수로 변환
    avgAmps = abs(avgAmps);

    // 0.1A 이하이면 0으로 처리
    if (avgAmps <= 0.03) {
      avgAmps = 0.0;
    }

    Serial.print("S");
    Serial.print(i + 1);
    Serial.print(",");
    Serial.print(avgAmps, 3);

    if (i < SENSOR_COUNT - 1) {
      Serial.print(",");
    }
  }

  Serial.println();

  for (int i = 0; i < SENSOR_COUNT; i++) {
    voltageSum[i] = 0.0;
    currentSum[i] = 0.0;
  }

  sampleCount = 0;
}

void setup() {
  Serial.begin(9600);
  Serial.setTimeout(100);

  delay(1500);

  for (int i = 0; i < SENSOR_COUNT; i++) {
    zeroOffsetV[i] = calibrateZeroOffset(ACS_PINS[i]);
  }

  lastSampleTime = millis();
}

void resetZeroOffset() {

  Serial.println("CAL_ZERO_START");

  for (int i = 0; i < SENSOR_COUNT; i++) {

    zeroOffsetV[i] = calibrateZeroOffset(ACS_PINS[i]);

  }

  // 기존 누적 데이터 초기화
  for (int i = 0; i < SENSOR_COUNT; i++) {
    voltageSum[i] = 0.0;
    currentSum[i] = 0.0;
  }

  sampleCount = 0;

  // 샘플링 시간 초기화
  lastSampleTime = millis();

  Serial.println("CAL_ZERO_DONE");
}

void loop() {

  unsigned long now = millis();

  if (now - lastSampleTime >= SAMPLE_INTERVAL_MS) {
    lastSampleTime = now;
    accumulateSensorData();
  }

  if (Serial.available() > 0) {

    String cmd = Serial.readStringUntil('\n');
    cmd.trim();

    if (cmd.equalsIgnoreCase("REQ_DATA")) {

      sendAverageDataAndReset();

    }
    else if (cmd.equalsIgnoreCase("CAL_ZERO")) {

      resetZeroOffset();

    }
  }
}